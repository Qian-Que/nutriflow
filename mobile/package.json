  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:android:local": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-install-android.ps1",
    "build:android:release": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-install-android.ps1 -Variant release -PrebuildClean",
