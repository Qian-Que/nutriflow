{
  "expo": {
    "name": "NutriFlow",
    "slug": "nutrition-assistant-cn",
    "version": "1.7.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F6F6F8"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "versionCode": 13,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F6F6F8"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.qianque1.nutritionassistantcn"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "3741dcd1-d739-4881-af01-9d6cf258927f"
      }
    },
    "plugins": [
      "expo-font",
      ["expo-splash-screen", {"image":"./assets/splash-icon.png", "imageWidth":200, "backgroundColor":"#F6F6F8", "resizeMode":"contain"}],
      "./plugins/withBrandTheme",
      "./plugins/withLocalNetwork"
    ]
  }
}
